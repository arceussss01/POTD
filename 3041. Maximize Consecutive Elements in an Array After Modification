class Solution {
public:
    int n;
    vector<vector<int>> memo; 

    int findMethod(int start, int target, vector<int>&nums){
        int j = lower_bound(begin(nums) + start, end(nums), target) - begin(nums);

        if(j < n && nums[j] == target){
            return j;
        }

        return -1;
    }

    int solve(int i, int inc, vector<int>&nums){
        if(i >= n) return 0;

        if(memo[i][inc] != -1){
            return memo[i][inc];
        }

        int currVal = nums[i] + inc;
        int len = 1;
        // first option is to find the currVal + 1 directly
        int j = findMethod(i+1, currVal + 1, nums);
        if(j != -1){
            len = max(len, 1 + solve(j, 0, nums));
        }

        // find curr value and add +1 on it
        j = findMethod(i+1, currVal, nums);
        if(j != -1){
            len = max(len, 1 + solve(j, 1, nums));
        }

        return memo[i][inc] = len;
    }

    int maxSelectedElements(vector<int>& nums) {
        n = nums.size();
        memo.assign(n+1, vector<int>(2, -1));
        sort(nums.begin(), nums.end());
        int result = 1;

        for(int i=0; i<n; i++){
            result = max({solve(i, 0, nums), solve(i, 1, nums), result});
        }
        return result;
    }
};
