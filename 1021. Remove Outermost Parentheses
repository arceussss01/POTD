class Solution {
public:
    string removeOuterParentheses(string s) {
        string res;
        int level = 0;
        int n = s.length();

        for(int i=0; i<n; i++){
            if(s[i] == '('){
                if(level > 0){
                    res.push_back(s[i]);
                }
                level++;
            } else{
                level--;
                if(level > 0){
                    res.push_back(s[i]);
                }
            }
        }
    return res;
    }
};
