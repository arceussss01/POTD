// Solution
class Solution {
public:
    int reverseDegree(string s) {
        int n = s.length();
        int sum = 0;

        for(int i=0; i<n; i++){
            char c = s[i];
            int revIdx = 26 - (c - 'a');
            int idx = i+1;
            sum += revIdx * idx;
        }
    return sum;
    }
};
