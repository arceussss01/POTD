class Solution {
#define ll long long
public:
    long long countCommas(long long n) {
        ll result = 0;

        ll lower = 1000;
        ll commas = 1;

        while(lower <= n){
            ll upper = lower * 1000 - 1;
            if(upper > n) upper = n;

            ll countNumbers = upper - lower + 1;
            result += (countNumbers * commas);

            lower *= 1000;
            commas++;
        }
    return result;
    }
};
