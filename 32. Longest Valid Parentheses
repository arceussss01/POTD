class Solution {
public:
    int longestValidParentheses(string s) {
        int n = s.length();
        int open = 0;
        int close = 0;
        int size = 0;

        // left to right
        for(int i=0; i<n; i++){
            if(s[i] == '('){
                open++;
            } else{
                close++;
            }

            if(open == close){
                size = max(size, close + open);
            } else if(close > open){
                open = 0;
                close = 0;
            }
        }

        open = 0;
        close = 0;
        // right to left
        for(int i=n-1; i>=0; i--){
            if(s[i] == '('){
                open++;
            } else{
                close++;
            }

            if(open == close){
                size = max(size, close + open);
            } else if(open > close){
                open = 0;
                close = 0;
            }
        }
    return size;
    }
};
