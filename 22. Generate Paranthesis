class Solution {
public:
    vector<string> ans;
    void generate(string &s, int open, int close, int n){
        if(s.size() == 2 * n){
            ans.push_back(s);
            return;
        }

        if(open < n){
            s.push_back('(');
            generate(s, open + 1, close, n);
            // undo choices for other options
            s.pop_back();
        }

        if(close < open){
            s.push_back(')');
            generate(s, open, close + 1, n);
            // undo choices for exploring other options
            s.pop_back();
        }
    }

    vector<string> generateParenthesis(int n) {
        ans.clear();
        string s;
        s.reserve(2 * n);

        generate(s, 0, 0, n);

        return ans;
    }
};
