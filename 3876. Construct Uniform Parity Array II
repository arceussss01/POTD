class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int minEl = *min_element(begin(nums1), end(nums1));
        
        if(minEl % 2 == 1){
            return true;
        }

        for(int &it : nums1){
            if(it % 2 == 1){
                return false;
            }
        }
    return true;
    }
};
