class Solution {
public:
    int digitSum(int n){
        int temp = n;
        int sum = 0;
        while(temp > 0){
            int d = temp % 10;
            sum += d;
            temp /= 10;
        }
        return sum;
    }

    int smallestIndex(vector<int>& nums) {
        int n = nums.size();

        for(int i=0; i<n; i++){
            if(digitSum(nums[i]) == i){
                return i;
            }
        }
    return -1;
    }
};
