class Solution {
public:
    int digitSum(int num){
        int sum = 0;
        while(num > 0){
            sum += num % 10;
            num = num / 10;
        }
    return sum;
    }

    int minSwaps(vector<int>& nums) {
        int n = nums.size();
        vector<int> afterSorted(nums);

        auto lambda = [&](int num1, int num2){
            int n1 = digitSum(num1);
            int n2 = digitSum(num2);

            if(n1 != n2){
                return n1 < n2;
            }
            return num1 < num2;
        };

        sort(begin(afterSorted), end(afterSorted), lambda);

        unordered_map<int, int> valToIdx;
        for(int i=0; i<n; i++){
            valToIdx[nums[i]] = i;
        }

        int swapCount = 0;
        for(int i=0; i<n; i++){
            int expectedVal = afterSorted[i];
            int currVal = nums[i];

            if(expectedVal == currVal) continue;
           
            int idx = valToIdx[expectedVal];
            nums[i] = expectedVal;
            nums[idx] = currVal;
            valToIdx[expectedVal] = i;
            valToIdx[currVal] = idx;

            swapCount++;
        }
    return swapCount;
    }
};
