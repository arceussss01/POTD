class Solution {
public:
    int maximumSaleItems(vector<vector<int>>& items, int budget) {
        int n = items.size();
        int mx = 0;
        int mn = INT_MAX;

        vector<int> freq(n + 1, 0);

        for (auto &it : items) {
            freq[it[0]]++;
            mx = max(mx, it[0]);
            mn = min(mn, it[1]);
        }

        vector<int> gain(mx + 1, 0);

        for (int i = 1; i <= mx; i++) {
            for (int j = i; j <= mx; j += i) {
                gain[i] += freq[j];
            }
            gain[i]--;
        }

        sort(items.begin(), items.end(),
             [](const vector<int>& a, const vector<int>& b) {
                 return a[1] < b[1];
             });

        long long ans = 0;
        long long b = budget;

        for (auto &it : items) {
            int factor = it[0];
            int price = it[1];

            if (price > 2LL * mn) break;
            if (gain[factor] == 0) continue;

            long long cnt = min((long long)gain[factor], b / price);

            ans += 2 * cnt;
            b -= cnt * price;
        }

        ans += b / mn;

        return ans;
    }
};
