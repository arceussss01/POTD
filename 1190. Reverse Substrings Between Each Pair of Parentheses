// Using Stack

class Solution {
public:
    string reverseParentheses(string s) {
        stack<int> lastSkipLen;

        string result;

        for(char &ch : s){
            if(ch == '('){
                lastSkipLen.push(result.length());
            } else if(ch == ')'){
                int l = lastSkipLen.top();
                lastSkipLen.pop();
                reverse(begin(result) + l, end(result));
            } else{
                result.push_back(ch);       
            }
        }
    return result;
    }
};
