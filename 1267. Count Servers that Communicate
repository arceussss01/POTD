class Solution {
public:
    int countServers(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        vector<int> rowCount(m, 0);
        vector<int> colCount(n, 0);

        for(int row = 0; row < m; row++){
            for(int col = 0; col < n; col++){
                if(grid[row][col] == 1){
                    rowCount[row] += 1;
                    colCount[col] += 1;
                }
            }
        }


        int count = 0;
        for(int row = 0; row < m; row++){
            for(int col = 0; col < n; col++){
                if(grid[row][col] == 1){
                    if(rowCount[row] > 1 ||  colCount[col] > 1){
                        count++;
                    }
                }
            }
        }
    return count;
    }
};
