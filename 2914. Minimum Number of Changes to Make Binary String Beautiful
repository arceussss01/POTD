class Solution {
public:
    int minChanges(string s) {
        int n = s.length();

        int count = 0;
        int change = 0;
        char ch = s[0];

        for(int i=0; i<n; i++){
            if(s[i] == ch){
                count++;
                continue;
            }

            if(count % 2 == 0){
                count = 1;
            } else{
                change += 1;
                count = 0;
            }

            ch = s[i];
        }
    return change;
    }
};
